{
  "name": "abriand-it-2i2d",
  "displayName": "ABriand IT-2I2D",
  "description": "Pack d'extensions à destination des élèves d'IT et 2I2D du lycée Aristide Briand.",
  "version": "0.1.7",
  "author": {
    "name": "Frank SAURET",
    "email": "frank.sauret.prof@gmail.com",
    "url": "http://www.electropol.fr/"
  },
  "publisher": "electropol-fr",
  "repository": {
    "type": "git",
    "url": "https://github.com/FrankSAURET/abriand-it-2i2d"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.104.0"
  },
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "abriand-it-2i2d.configurer",
        "title": "ABriand IT-2I2D : Configurer"
      }
    ]
  },
  "icon": "image/LogoAbriandIT2I2D.png",
  "galleryBanner": {
    "color": "#43C62B",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://badgen.net/github/stars/FrankSAURET/abriand-it-2i2d?icon=github",
